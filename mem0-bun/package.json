{
  "name": "@mem0/bun",
  "version": "0.1.0",
  "description": "Local-first TypeScript rewrite of Mem0 OSS, powered by Bun.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=./coverage",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mem0",
    "memory",
    "llm",
    "ai",
    "agents",
    "bun",
    "typescript",
    "local-first",
    "vector-store"
  ],
  "author": "Mem0 Bun Rewrite",
  "license": "Apache-2.0",
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
